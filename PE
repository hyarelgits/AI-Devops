Step 15: Create query.py

Shell
nano query.py

Add:

Python
import chromadb
import subprocess
 
question = input("Ask Question: ")
 
client = chromadb.PersistentClient(path="../chroma_db")
 
collection = client.get_collection("enterprise_docs")
 
result = collection.query(
query_texts=[question],
n_results=1
)
 
context = result["documents"][0][0]
 
prompt = f"""
Context:
{context}
 
Question:
{question}
"""
 
subprocess.run(
[
"ollama",
"run",
"qwen2.5:3b",
prompt
]
)

