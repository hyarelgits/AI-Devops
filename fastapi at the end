from fastapi import FastAPI
import chromadb
import subprocess

app = FastAPI()

@app.get("/")
def home():
    return {
        "message": "AI Operations Assistant Running"
    }

@app.get("/ask")
def ask(question: str):

    client = chromadb.PersistentClient(
        path="/root/enterprise-ai-platform/chroma_db"
    )

    collection = client.get_collection(
        "enterprise_docs"
    )

    result = collection.query(
        query_texts=[question],
        n_results=1
    )

    context = result["documents"][0][0]

    prompt = f"""
Use this context to answer.

Context:
{context}

Question:
{question}
"""

    response = subprocess.check_output(
        [
            "ollama",
            "run",
            "qwen2.5:3b",
            prompt
        ],
        text=True
    )

    return {
        "question": question,
        "context": context,
        "answer": response
    }

