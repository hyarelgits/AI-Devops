from doc_agent import process as doc_process
from security_agent import process as sec_process
from incident_agent import process as inc_process

def route(question):

    if "security" in question.lower():
        return sec_process(question)

    if "incident" in question.lower():
        return inc_process(question)

    return doc_process(question)




