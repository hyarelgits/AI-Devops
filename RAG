import os

DOCUMENTS = []

for root, dirs, files in os.walk("../docs"):
    for file in files:
        path = os.path.join(root, file)

        with open(path, "r") as f:
            text = f.read()

        DOCUMENTS.append(
            {
                "file": file,
                "content": text
            }
        )

print(DOCUMENTS)



