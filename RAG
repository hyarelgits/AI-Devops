import chromadb

client = chromadb.PersistentClient(
    path="../chroma_db"
)

collection = client.get_or_create_collection(
    "enterprise_docs"
)

collection.add(
    ids=["1"],
    documents=[
        "Database Recovery Step 1 Backup"
    ]
)

print("Stored")


